.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Env / secrets
.env
.env.*
*.pem
*.key

# Temp
*.tmp
*.bak


# -------------------------
# Your custom upload rules
# -------------------------

# Ignore everything under data
data/**

# But keep catalog and its contents
!data/catalog/
!data/catalog/**
!data/meta/
!data/meta/**

# Exclude large DuckDB warehouse file
data/meta/warehouse.duckdb

# Ignore everything under arichitecture
arichitecture/**


